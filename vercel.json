{
  "git": {
    "deploymentEnabled": {
      "main": true,
      "cursor/**": false
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Gogogo-Build",
          "value": "admin-nofocus-zoom-1"
        }
      ]
    }
  ]
}
