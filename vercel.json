{
  "git": {
    "deploymentEnabled": {
      "main": true,
      "cursor/**": false
    }
  },
  "redirects": [
    {
      "source": "/zirkeltraining",
      "destination": "/zirkeltraining/",
      "permanent": false
    },
    {
      "source": "/natalyaalice",
      "destination": "/natalyaalice/",
      "permanent": false
    },
    {
      "source": "/joscha/plaene",
      "destination": "/joscha/plaene/",
      "permanent": false
    },
    {
      "source": "/plan/:slug/",
      "destination": "/plan/:slug",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/cal/:slug",
      "destination": "/api/calendar/:slug"
    },
    {
      "source": "/plan/:slug",
      "destination": "/plan/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/calendar/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    },
    {
      "source": "/cal/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    },
    {
      "source": "/natalyaalice",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/natalyaalice/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/plan",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/plan/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/joscha/plaene",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/joscha/plaene/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Gogogo-Build",
          "value": "delete-user-block-1"
        }
      ]
    }
  ]
}
