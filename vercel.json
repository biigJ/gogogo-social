{
  "git": {
    "deploymentEnabled": {
      "main": true,
      "cursor/**": false
    }
  },
  "rewrites": [
    {
      "source": "/cal/:slug",
      "destination": "/api/calendar/:slug"
    },
    {
      "source": "/zirkeltraining",
      "destination": "https://zirkeltraining.vercel.app/"
    },
    {
      "source": "/zirkeltraining/",
      "destination": "https://zirkeltraining.vercel.app/"
    },
    {
      "source": "/_next/:path*",
      "destination": "https://zirkeltraining.vercel.app/_next/:path*"
    }
  ],
  "headers": [
    {
      "source": "/api/calendar/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    },
    {
      "source": "/cal/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Gogogo-Build",
          "value": "delete-user-block-1"
        }
      ]
    }
  ]
}
